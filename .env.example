# =============================================================================
# HANOI PM2.5 WEBGIS — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and fill in your personal keys.
# NEVER commit the real .env file to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api/v1

# -----------------------------------------------------------------------------
# 2. EXTERNAL AIR QUALITY & WEATHER DATA SOURCES
# -----------------------------------------------------------------------------
# OpenAQ API v3 Key (Required for real PM2.5 station measurements in ug/m3)
# Register for free at: https://explore.openaq.org/register
OPENAQ_API_KEY=

# WAQI / AQICN API Token (Optional/Recommended for supplementary station AQI)
# Register for free at: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=

# Open-Meteo APIs (No API key required for non-commercial academic use)
OPEN_METEO_AQ_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SUPABASE POSTGRESQL + POSTGIS — STAGE 3)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 4. SECURITY & SCHEDULER CONFIGURATION
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
CRON_SECRET=replace_with_a_strong_cron_trigger_secret
INGEST_STATION_INTERVAL_MINUTES=15
INGEST_MODEL_INTERVAL_MINUTES=60
